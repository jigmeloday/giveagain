# Copy to .env.local (git-ignored) and fill in. Names only here, never real values.

# Pooled connection string used by the app (on Neon, the host with "-pooler"). Use sslmode=verify-full.
DATABASE_URL=
# Direct (unpooled) connection string, used for migrations and create-admin only (on Neon, the host without "-pooler")
DATABASE_URL_UNPOOLED=
# Separate throwaway database for tests. Never point this at dev or production.
TEST_DATABASE_URL=

# Better Auth: long random secret (openssl rand -base64 32) and the public base URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Photo storage (Neon Object Storage, S3-compatible). Set by `neon env pull` after the bucket exists.
AWS_ENDPOINT_URL_S3=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Optional. Defaults to photos.
PHOTO_BUCKET=
